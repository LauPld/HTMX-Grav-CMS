{# Fragment pour la gestion des messages #}
{% if app.request.method == 'PUT' %}
  
    <strong style="color: #9AEF9A;">Message Updated</strong>
    <p>Your message has been processed successfully.</p>
    <p>Feel free to add more content here.</p>
  
{% else %}
  {# État initial : affiché lors du GET ou de l'inclusion initiale #}
  <button hx-put="/components/messages" class="btn-htmx">
    Put To Messages
  </button>
{% endif %}
